# =================================================================
# RepoMedic AI Configuration Environment Variables Template
# Copy to .env and customize. NEVER commit real secrets or tokens!
# =================================================================

# Runtime Environment (development | production | test)
REPOMEDIC_ENVIRONMENT=development
REPOMEDIC_DEBUG=false
REPOMEDIC_HOSTED_MODE=false

# Server Network Settings
REPOMEDIC_HOST=0.0.0.0
REPOMEDIC_PORT=8000
PORT=8000

# -----------------------------------------------------------------
# Model Provider Selection: "ollama" | "openai_compatible" | "mock"
# -----------------------------------------------------------------
REPOMEDIC_MODEL_PROVIDER=ollama

# Local Inference (Ollama)
REPOMEDIC_OLLAMA_BASE_URL=http://localhost:11434
REPOMEDIC_OLLAMA_MODEL=qwen2.5-coder:7b

# Hosted / Cloud Inference (vLLM, OpenRouter, Together, Groq)
REPOMEDIC_OPENAI_BASE_URL=https://api.openai.com/v1
REPOMEDIC_OPENAI_MODEL=qwen/qwen-2.5-coder-7b-instruct
REPOMEDIC_OPENAI_API_KEY=your_hosted_inference_api_key_here

# Inference Controls
REPOMEDIC_MODEL_TIMEOUT_SECONDS=45.0
REPOMEDIC_MODEL_MAX_RETRIES=2
REPOMEDIC_MODEL_TEMPERATURE=0.1

# -----------------------------------------------------------------
# Orchestrator & Safety Harness
# -----------------------------------------------------------------
REPOMEDIC_MAX_REPAIR_ATTEMPTS=3
REPOMEDIC_TEST_TIMEOUT_SECONDS=30.0

# Context & File Size Guards
REPOMEDIC_MAX_CONTEXT_BYTES=65536
REPOMEDIC_MAX_FILE_SIZE_BYTES=262144
REPOMEDIC_MAX_FILES_SCANNED=200

# Docker Sandbox Controls (for local arbitrary repo test isolation)
REPOMEDIC_DOCKER_ENABLED=true
REPOMEDIC_DOCKER_IMAGE=python:3.11-slim
REPOMEDIC_DOCKER_MEMORY_LIMIT=512m
REPOMEDIC_DOCKER_CPU_LIMIT=1.0
REPOMEDIC_DOCKER_PIDS_LIMIT=64
